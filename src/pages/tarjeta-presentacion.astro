  <script>
    declare const html2canvas: any;

    function downloadSide(elementId: string, filename: string) {
      const element = document.getElementById(elementId);
      if (!element) return;

      if (typeof html2canvas !== 'undefined') {
        html2canvas(element, {
          scale: 3,
          useCORS: true,
          backgroundColor: null,
          logging: false
        }).then((canvas: HTMLCanvasElement) => {
          const link = document.createElement('a');
          link.download = filename;
          link.href = canvas.toDataURL('image/png');
          link.click();
        }).catch((err: any) => {
          console.error('Error al exportar imagen:', err);
          alert('Hubo un error al generar la imagen. Puedes usar la función de captura o imprimir como PDF.');
        });
      }
    }

    document.getElementById('btn-dl-front')?.addEventListener('click', () => downloadSide('card-front', 'tarjeta-corepalm-anverso.png'));
    document.getElementById('link-dl-front')?.addEventListener('click', () => downloadSide('card-front', 'tarjeta-corepalm-anverso.png'));
    document.getElementById('btn-dl-back')?.addEventListener('click', () => downloadSide('card-back', 'tarjeta-corepalm-reverso.png'));
    document.getElementById('link-dl-back')?.addEventListener('click', () => downloadSide('card-back', 'tarjeta-corepalm-reverso.png'));
    document.getElementById('btn-print')?.addEventListener('click', () => window.print());
  </script>

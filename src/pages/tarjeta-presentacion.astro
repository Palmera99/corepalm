---
// tarjeta-presentacion.astro - Digital & Printable Business Card Page
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tarjeta de Presentación | CorePalm Soluciones</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- html2canvas for instant 1-click PNG export -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    /* --- CSS Reset & Variables --- */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --color-navy-900: #0b192c;
      --color-navy-800: #0f243e;
      --color-navy-700: #1e3e62;
      --color-blue-500: #2563eb;
      --color-blue-400: #3b82f6;
      --color-blue-100: #dbeafe;
      --color-amber: #f59e0b;
      --color-emerald: #10b981;
      --color-gray-900: #0f172a;
      --color-gray-700: #334155;
      --color-gray-500: #64748b;
      --color-gray-200: #e2e8f0;
      --color-gray-100: #f1f5f9;
      --color-white: #ffffff;
      --font-heading: 'Outfit', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      font-family: var(--font-body);
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0b192c 100%);
      color: var(--color-white);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 2.5rem 1rem;
    }

    /* Header Bar / Toolbar */
    .toolbar {
      max-width: 980px;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 1.2rem 1.6rem;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    }

    .toolbar__brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .toolbar__title {
      font-family: var(--font-heading);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--color-white);
    }

    .toolbar__subtitle {
      font-size: 0.82rem;
      color: #94a3b8;
    }

    .toolbar__actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.6rem 1.1rem;
      font-size: 0.88rem;
      font-weight: 600;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn--primary {
      background-color: var(--color-blue-500);
      color: var(--color-white);
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }

    .btn--primary:hover {
      background-color: #1d4ed8;
      transform: translateY(-2px);
    }

    .btn--success {
      background-color: #059669;
      color: var(--color-white);
      box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
    }

    .btn--success:hover {
      background-color: #047857;
      transform: translateY(-2px);
    }

    .btn--secondary {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--color-white);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn--secondary:hover {
      background-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    /* --- Business Cards Presentation Showcase --- */
    .cards-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem;
      max-width: 1000px;
      width: 100%;
      margin-bottom: 2.5rem;
    }

    .card-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }

    .card-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 440px;
      padding: 0 0.25rem;
    }

    .card-label {
      font-family: var(--font-heading);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #94a3b8;
      font-weight: 700;
    }

    .card-download-link {
      font-size: 0.78rem;
      color: #60a5fa;
      background: rgba(37, 99, 235, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .card-download-link:hover {
      background: rgba(37, 99, 235, 0.3);
      color: var(--color-white);
    }

    /* Standard Business Card Dimensions: 3.5in x 2in (89mm x 51mm) */
    .business-card {
      width: 440px;
      height: 250px;
      border-radius: 14px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .business-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(59, 130, 246, 0.4);
    }

    /* === FRONT OF CARD === */
    .card-front {
      background: linear-gradient(135deg, #0b192c 0%, #1e3e62 100%);
      padding: 1.6rem 1.8rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: var(--color-white);
    }

    .card-front::before {
      content: '';
      position: absolute;
      top: -40px;
      right: -40px;
      width: 160px;
      height: 160px;
      background: radial-gradient(circle, rgba(37, 99, 235, 0.3) 0%, rgba(37, 99, 235, 0) 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .card-front::after {
      content: '';
      position: absolute;
      bottom: -30px;
      left: 30%;
      width: 200px;
      height: 100px;
      background: linear-gradient(90deg, rgba(245, 158, 11, 0.15), transparent);
      transform: rotate(-15deg);
      pointer-events: none;
    }

    .card-front__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      position: relative;
      z-index: 2;
    }

    .card-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .card-brand__logo {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      background: #1e3e62;
      border: 1px solid rgba(59, 130, 246, 0.5);
      border-radius: 8px;
    }

    .card-brand__text {
      display: flex;
      flex-direction: column;
    }

    .card-brand__name {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .card-brand__slogan {
      font-size: 0.65rem;
      font-weight: 600;
      color: #93c5fd;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .card-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(245, 158, 11, 0.18);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
      padding: 0.25rem 0.6rem;
      border-radius: 9999px;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .card-front__body {
      margin-top: 0.5rem;
      position: relative;
      z-index: 2;
    }

    .card-contact-name {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--color-white);
    }

    .card-contact-title {
      font-size: 0.78rem;
      font-weight: 500;
      color: #60a5fa;
      letter-spacing: 0.02em;
    }

    .card-front__footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0.8rem;
      padding-top: 0.6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      position: relative;
      z-index: 2;
    }

    .card-info-item {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.74rem;
      color: #e2e8f0;
      text-decoration: none;
    }

    .card-info-item svg {
      flex-shrink: 0;
      color: #60a5fa;
    }

    /* === BACK OF CARD === */
    .card-back {
      background: linear-gradient(135deg, #0f172a 0%, #0b192c 100%);
      padding: 1.5rem 1.8rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: var(--color-white);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .card-back__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-back__title {
      font-family: var(--font-heading);
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--color-white);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-back__subtitle {
      font-size: 0.68rem;
      color: #fbbf24;
      font-weight: 700;
    }

    .card-back__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
      margin: 0.5rem 0;
    }

    .service-pill {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.35rem 0.55rem;
      border-radius: 6px;
    }

    .service-pill__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 4px;
      flex-shrink: 0;
    }

    .service-pill__icon--software { background: rgba(37, 99, 235, 0.2); color: #60a5fa; }
    .service-pill__icon--cctv { background: rgba(239, 68, 68, 0.2); color: #f87171; }
    .service-pill__icon--network { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .service-pill__icon--hardware { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }

    .service-pill__text {
      display: flex;
      flex-direction: column;
    }

    .service-pill__text strong {
      font-size: 0.72rem;
      line-height: 1.1;
      color: var(--color-white);
    }

    .service-pill__text span {
      font-size: 0.62rem;
      color: #94a3b8;
    }

    .card-back__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-back__qr-block {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .card-qr-box {
      width: 38px;
      height: 38px;
      background: var(--color-white);
      padding: 3px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-qr-box svg {
      width: 100%;
      height: 100%;
    }

    .card-qr-desc {
      display: flex;
      flex-direction: column;
    }

    .card-qr-desc strong {
      font-size: 0.7rem;
      color: var(--color-white);
    }

    .card-qr-desc span {
      font-size: 0.62rem;
      color: #94a3b8;
    }

    .card-back__website {
      font-family: var(--font-heading);
      font-size: 0.82rem;
      font-weight: 700;
      color: #60a5fa;
    }

    /* Realistic JPG Mockup Container */
    .mockup-container {
      max-width: 980px;
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
      margin-bottom: 2.5rem;
      text-align: center;
    }

    .mockup-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.2rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .mockup-title {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: 700;
    }

    .mockup-img {
      width: 100%;
      max-height: 520px;
      object-fit: cover;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    /* Print Specific Styles */
    @media print {
      body {
        background: white !important;
        color: black !important;
        padding: 0 !important;
      }

      .toolbar, .mockup-container, .card-download-link {
        display: none !important;
      }

      .cards-container {
        gap: 20mm;
        margin: 10mm auto;
      }

      .business-card {
        box-shadow: none !important;
        border: 1px solid #ccc !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        page-break-inside: avoid;
      }
    }

    @media (max-width: 520px) {
      .business-card {
        width: 340px;
        height: 220px;
        border-radius: 10px;
      }
      .card-front, .card-back {
        padding: 1.2rem;
      }
      .card-brand__name, .card-contact-name {
        font-size: 1.05rem;
      }
      .card-info-item {
        font-size: 0.68rem;
      }
    }
  </style>
</head>
<body>

  <!-- Top Toolbar -->
  <div class="toolbar">
    <div class="toolbar__brand">
      <svg viewBox="0 0 36 36" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="36" height="36" rx="8" fill="#1E3E62"/>
        <path d="M18 8L27 13.5V22.5L18 28L9 22.5V13.5L18 8Z" stroke="#3B82F6" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="18" cy="18" r="4" fill="#60A5FA"/>
      </svg>
      <div>
        <h1 class="toolbar__title">Tarjeta de Presentación Corporativa</h1>
        <p class="toolbar__subtitle">CorePalm Soluciones | Formatos JPG / PNG / PDF Imprimible (89 × 51 mm)</p>
      </div>
    </div>

    <div class="toolbar__actions">
      <button type="button" class="btn btn--success" id="btn-dl-front">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Descargar Anverso (PNG)</span>
      </button>

      <button type="button" class="btn btn--success" id="btn-dl-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Descargar Reverso (PNG)</span>
      </button>

      <button type="button" class="btn btn--primary" id="btn-print">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Imprimir / PDF</span>
      </button>

      <a href="/" class="btn btn--secondary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Web Principal</span>
      </a>
    </div>
  </div>

  <!-- Cards Presentation Grid -->
  <div class="cards-container">
    <!-- FRONT OF CARD -->
    <div class="card-wrapper">
      <div class="card-header-bar">
        <span class="card-label">Anverso (Frente)</span>
        <button class="card-download-link" id="link-dl-front">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Exportar PNG
        </button>
      </div>

      <div class="business-card card-front" id="card-front">
        <div class="card-front__header">
          <div class="card-brand">
            <div class="card-brand__logo">
              <svg viewBox="0 0 36 36" width="24" height="24" fill="none">
                <path d="M18 8L27 13.5V22.5L18 28L9 22.5V13.5L18 8Z" stroke="#3B82F6" stroke-width="2.5" stroke-linejoin="round"/>
                <circle cx="18" cy="18" r="4" fill="#60A5FA"/>
                <path d="M18 12V14M18 22V24M12 18H14M22 18H24" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="card-brand__text">
              <span class="card-brand__name">CorePalm</span>
              <span class="card-brand__slogan">Soluciones Tecnológicas</span>
            </div>
          </div>
          <div class="card-badge">
            <span>+5 Años Exp.</span>
          </div>
        </div>

        <div class="card-front__body">
          <div class="card-contact-name">Equipo de Soluciones TI</div>
          <div class="card-contact-title">Software • Seguridad CCTV • Redes • Soporte</div>
        </div>

        <div class="card-front__footer">
          <a href="tel:+56912345678" class="card-info-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+56 9 1234 5678</span>
          </a>

          <a href="mailto:contacto@corepalm.com" class="card-info-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>contacto@corepalm.com</span>
          </a>

          <div class="card-info-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>www.corepalm.com</span>
          </div>

          <div class="card-info-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Cobertura Regional y Nacional</span>
          </div>
        </div>
      </div>
    </div>

    <!-- BACK OF CARD -->
    <div class="card-wrapper">
      <div class="card-header-bar">
        <span class="card-label">Reverso (Dorso)</span>
        <button class="card-download-link" id="link-dl-back">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Exportar PNG
        </button>
      </div>

      <div class="business-card card-back" id="card-back">
        <div class="card-back__header">
          <span class="card-back__title">Nuestros Servicios</span>
          <span class="card-back__subtitle">Garantía & Confianza</span>
        </div>

        <div class="card-back__grid">
          <div class="service-pill">
            <div class="service-pill__icon service-pill__icon--software">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">

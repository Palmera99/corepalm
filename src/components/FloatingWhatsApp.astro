---
// FloatingWhatsApp.astro - Floating Direct Action Button
---
<a href="https://wa.me/56912345678?text=Hola%20CorePalm%20Soluciones,%20deseo%20solicitar%20informaci%C3%B3n" class="floating-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.781 2.8.781h.005c3.18 0 5.767-2.587 5.768-5.766.001-1.54-.598-2.988-1.688-4.078-1.09-1.09-2.538-1.689-4.088-1.689zm8.175 1.583c1.651 1.652 2.56 3.847 2.559 6.18-.003 4.819-3.921 8.736-8.74 8.736-1.528 0-2.981-.397-4.26-1.149l-6.765 1.774 1.808-6.595a8.708 8.708 0 0 1-1.282-4.945c.002-4.819 3.92-8.737 8.74-8.737 2.333 0 4.529.909 6.18 2.561l-.24.175zm-3.606 7.644c-.2-.1-.1.2-.42.06-.32-.14-1.85-.91-2.14-1.02-.29-.11-.5-.16-.71.16-.21.32-.82 1.02-.99 1.23-.17.21-.34.24-.66.08-.32-.16-1.34-.49-2.55-1.57-.94-.84-1.58-1.88-1.76-2.2-.18-.32-.02-.49.14-.65.15-.14.32-.37.48-.55.16-.18.21-.31.32-.52.1-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.53-.71-.54-.18-.01-.39-.01-.6-.01-.21 0-.55.08-.84.4-.29.32-1.1 1.07-1.1 2.62 0 1.54 1.13 3.03 1.29 3.25.16.21 2.21 3.38 5.36 4.74.75.32 1.33.52 1.79.66.75.24 1.44.21 1.98.13.6-.09 1.85-.76 2.11-1.49.26-.73.26-1.35.18-1.49-.08-.14-.29-.22-.61-.38z"/>
  </svg>
  <span class="floating-whatsapp__tooltip">¿Dudas? Escríbenos por WhatsApp</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 60px;
    height: 60px;
    background-color: #25d366;
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    z-index: 99;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .floating-whatsapp:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.55);
  }

  .floating-whatsapp__tooltip {
    position: absolute;
    right: 70px;
    background-color: var(--color-dark-900);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    pointer-events: none;
    opacity: 0;
    transform: translateX(10px);
    transition: all var(--transition-fast);
  }

  .floating-whatsapp:hover .floating-whatsapp__tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 480px) {
    .floating-whatsapp {
      bottom: 18px;
      right: 18px;
      width: 52px;
      height: 52px;
    }
    .floating-whatsapp__tooltip {
      display: none;
    }
  }
</style>

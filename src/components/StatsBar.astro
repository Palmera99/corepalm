---
// StatsBar.astro - Key Metrics & Credibility Bar
---
<div class="stats-bar">
  <div class="container stats-bar__grid">
    <div class="stat-item">
      <div class="stat-item__number">+5</div>
      <div class="stat-item__label">Años de Experiencia en el Sector</div>
    </div>
    <div class="stat-item">
      <div class="stat-item__number">+250</div>
      <div class="stat-item__label">Servicios e Instalaciones Exitosas</div>
    </div>
    <div class="stat-item">
      <div class="stat-item__number">99.5%</div>
      <div class="stat-item__label">Índice de Satisfacción de Clientes</div>
    </div>
    <div class="stat-item">
      <div class="stat-item__number">100%</div>
      <div class="stat-item__label">Garantía en Proyectos y Equipos</div>
    </div>
  </div>
</div>

<style>
  .stats-bar {
    background-color: var(--color-white);
    border-top: 1px solid var(--color-gray-200);
    padding: var(--space-8) 0;
  }

  .stats-bar__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .stat-item {
    text-align: center;
    padding: 0 var(--space-4);
    border-right: 1px solid var(--color-gray-200);
  }

  .stat-item:last-child {
    border-right: none;
  }

  .stat-item__number {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--color-primary-600);
    line-height: 1.1;
    margin-bottom: var(--space-1);
  }

  .stat-item__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-gray-600);
  }

  @media (max-width: 1024px) {
    .stats-bar__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
    .stat-item:nth-child(2) {
      border-right: none;
    }
  }

  @media (max-width: 480px) {
    .stats-bar__grid {
      grid-template-columns: 1fr;
    }
    .stat-item {
      border-right: none;
      border-bottom: 1px solid var(--color-gray-200);
      padding-bottom: var(--space-4);
    }
    .stat-item:last-child {
      border-bottom: none;
    }
  }
</style>

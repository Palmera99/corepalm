---
// TopBar.astro - Top Announcement Bar
---
<div class="top-bar">
  <div class="container top-bar__content">
    <div class="top-bar__info">
      <span class="top-bar__item">
        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <strong>+5 Años de Experiencia</strong> en el sector tecnológico
      </span>
      <span class="top-bar__separator">|</span>
      <span class="top-bar__item">
        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        Atención a empresas y particulares de Lun a Sáb
      </span>
    </div>
    <div class="top-bar__contact">
      <a href="tel:+56912345678" class="top-bar__link">
        <svg class="icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        +56 9 1234 5678
      </a>
      <a href="mailto:contacto@corepalm.com" class="top-bar__link">
        <svg class="icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        contacto@corepalm.com
      </a>
    </div>
  </div>
</div>

<style>
  .top-bar {
    background-color: var(--color-primary-900);
    color: var(--color-gray-300);
    font-size: 0.825rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top-bar__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .top-bar__info, .top-bar__contact {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .top-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .top-bar__separator {
    color: rgba(255, 255, 255, 0.2);
  }

  .top-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-gray-300);
  }

  .top-bar__link:hover {
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .top-bar {
      display: none;
    }
  }
</style>

---
// Footer.astro - Corporate Footer
---
<footer class="footer">
  <div class="container footer__container">
    <div class="footer__grid">
      <!-- Column 1: Brand -->
      <div class="footer__col footer__col--brand">
        <div class="logo logo--footer">
          <div class="logo__icon">
            <svg viewBox="0 0 36 36" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="36" height="36" rx="8" fill="#2563EB"/>
              <path d="M18 8L27 13.5V22.5L18 28L9 22.5V13.5L18 8Z" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/>
              <circle cx="18" cy="18" r="4" fill="#93C5FD"/>
            </svg>
          </div>
          <div class="logo__text">
            <span class="logo__title text-white">CorePalm</span>
            <span class="logo__tagline text-muted">Soluciones Tecnológicas</span>
          </div>
        </div>
        <p class="footer__about">
          Más de 5 años ofreciendo soluciones tecnológicas integrales: software personalizado, seguridad CCTV, cableado estructurado de redes y soporte de hardware.
        </p>
        <div class="footer__badge">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#60A5FA" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Empresa 100% comprometida con la excelencia técnica</span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer__col">
        <h4 class="footer__heading">Navegación Rápida</h4>
        <ul class="footer__links">
          <li><a href="#hero">Inicio</a></li>
          <li><a href="#nosotros">Acerca de Nosotros</a></li>
          <li><a href="#servicios">Servicios Principales</a></li>
          <li><a href="#por-que-elegirnos">Por Qué Elegirnos</a></li>
          <li><a href="#faq">Preguntas Frecuentes</a></li>
          <li><a href="#cotizacion">Solicitar Cotización</a></li>
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div class="footer__col">
        <h4 class="footer__heading">Nuestros Servicios</h4>
        <ul class="footer__links">
          <li><a href="#servicios" class="js-quote-service" data-service-value="software">Desarrollo de Software</a></li>
          <li><a href="#servicios" class="js-quote-service" data-service-value="cctv">Sistemas de Seguridad CCTV</a></li>
          <li><a href="#servicios" class="js-quote-service" data-service-value="redes">Infraestructura y Redes</a></li>
          <li><a href="#servicios" class="js-quote-service" data-service-value="hardware">Soporte Técnico y Hardware</a></li>
          <li><a href="#servicios" class="js-quote-service" data-service-value="integral">Proyectos Integrales TI</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div class="footer__col">
        <h4 class="footer__heading">Contacto Directo</h4>
        <ul class="footer__contact-list">
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#60A5FA" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>+56 9 1234 5678</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#60A5FA" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>contacto@corepalm.com</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#60A5FA" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Región Metropolitana y alrededores</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#60A5FA" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Lun - Vie: 8:30 a 18:30 | Sáb: 9:00 a 14:00</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; <span id="current-year">2026</span> <strong>CorePalm Soluciones</strong>. Todos los derechos reservados.</p>
      <p class="footer__legal">Servicios profesionales de Software, CCTV, Redes y Soporte de Hardware.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary-900);
    color: var(--color-gray-300);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr 1.2fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .logo--footer {
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo__icon {
    display: flex;
    align-items: center;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
  }

  .logo__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.28rem;
    line-height: 1.1;
  }

  .logo__tagline {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer__about {
    font-size: 0.9rem;
    color: var(--color-gray-300);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--color-primary-100);
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__heading {
    color: var(--color-white);
    font-size: 1.05rem;
    margin-bottom: var(--space-5);
    position: relative;
    padding-bottom: var(--space-2);
  }

  .footer__heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--color-primary-500);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__links a {
    font-size: 0.9rem;
    color: var(--color-gray-300);
  }

  .footer__links a:hover {
    color: var(--color-white);
    padding-left: 4px;
  }

  .footer__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: var(--color-gray-300);
  }

  .footer__contact-list li svg {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-6);
    font-size: 0.86rem;
    color: var(--color-gray-300);
  }

  .footer__bottom strong {
    color: var(--color-white);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__legal {
    color: var(--color-gray-300);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const currentYearSpan = document.getElementById('current-year');
  if (currentYearSpan) {
    currentYearSpan.textContent = String(new Date().getFullYear());
  }
</script>

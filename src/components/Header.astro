---
// Header.astro - Sticky Header Navigation
---
<header class="header" id="header">
  <div class="container header__container">
    <a href="#hero" class="logo" aria-label="CorePalm Soluciones - Inicio">
      <div class="logo__icon">
        <svg viewBox="0 0 36 36" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="36" height="36" rx="8" fill="#1E3E62"/>
          <path d="M18 8L27 13.5V22.5L18 28L9 22.5V13.5L18 8Z" stroke="#3B82F6" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="18" cy="18" r="4" fill="#60A5FA"/>
          <path d="M18 12V14M18 22V24M12 18H14M22 18H24" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="logo__text">
        <span class="logo__title">CorePalm</span>
        <span class="logo__tagline">Soluciones Tecnológicas</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav" id="main-nav" aria-label="Navegación principal">
      <ul class="nav__list">
        <li class="nav__item"><a href="#hero" class="nav__link active">Inicio</a></li>
        <li class="nav__item"><a href="#nosotros" class="nav__link">Nosotros</a></li>
        <li class="nav__item"><a href="#servicios" class="nav__link">Servicios</a></li>
        <li class="nav__item"><a href="#por-que-elegirnos" class="nav__link">Por Qué Elegirnos</a></li>
        <li class="nav__item"><a href="#faq" class="nav__link">Preguntas Frecuentes</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a href="#cotizacion" class="btn btn--primary header__btn">
        <span>Solicitar Cotización</span>
        <svg class="icon btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-gray-200);
    transition: all var(--transition-fast);
  }

  .header.scrolled {
    box-shadow: var(--shadow-md);
    background-color: rgba(255, 255, 255, 0.98);
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .logo:hover .logo__icon {
    transform: scale(1.04);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
  }

  .logo__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.28rem;
    color: var(--color-dark-900);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .logo__tagline {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-primary-600);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav__link {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--color-dark-700);
    position: relative;
    padding: 0.4rem 0;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-primary-500);
    transition: width var(--transition-fast);
    border-radius: var(--radius-full);
  }

  .nav__link:hover {
    color: var(--color-primary-600);
  }

  .nav__link:hover::after,
  .nav__link.active::after {
    width: 100%;
  }

  .nav__link.active {
    color: var(--color-primary-600);
  }

  .nav__link--badge {
    background-color: var(--color-primary-50);
    color: var(--color-primary-600);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--color-primary-100);
  }

  .nav__link--badge::after {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 110;
  }

  .mobile-toggle span {
    display: block;
    height: 2.5px;
    width: 100%;
    background-color: var(--color-dark-900);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .nav {
      position: fixed;
      top: 74px;
      left: 0;
      width: 100%;
      height: calc(100vh - 74px);
      background-color: var(--color-white);
      padding: var(--space-8) var(--space-6);
      transform: translateX(-100%);
      transition: transform var(--transition-smooth);
      border-top: 1px solid var(--color-gray-200);
      overflow-y: auto;
    }

    .nav.open {
      transform: translateX(0);
    }

    .nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .nav__link {
      font-size: 1.15rem;
    }

    .header__btn {
      display: none;
    }
  }
</style>

<script>
  // Sticky shadow & Mobile menu toggle client logic
  const header = document.getElementById('header');
  const mobileToggle = document.getElementById('mobile-toggle');
  const mainNav = document.getElementById('main-nav');
  const navLinks = document.querySelectorAll('.nav__link');

  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  if (mobileToggle && mainNav) {
    mobileToggle.addEventListener('click', () => {
      const isOpen = mainNav.classList.toggle('open');
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (mainNav.classList.contains('open')) {
          mainNav.classList.remove('open');
          mobileToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      });
    });
  }
</script>
